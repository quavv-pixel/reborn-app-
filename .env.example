# Copy to .env and uncomment what you need. Everything here is optional —
# the backend runs with zero edits, but Web Push stays disabled until
# REBORN_CONTACT is set.

# VAPID subject for Web Push. Push is OFF until this is set. Must be a real
# mailto: or https: URL you control — Apple's push service 403s on anything
# else instead of just failing quietly per-notification.
# REBORN_CONTACT=mailto:you@example.com

# API access token. Unset means a random one is generated into
# data/token.json and printed at startup.
# REBORN_TOKEN=

# HTTP port for the backend.
# PORT=3131

# Bind address. 0.0.0.0 by default so a tunnel can reach it; set 127.0.0.1
# if you only ever access it from this machine.
# REBORN_HOST=127.0.0.1

# Where state, tokens and keys live.
# REBORN_DATA_DIR=./data
