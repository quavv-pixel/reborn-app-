# Copy to .env and uncomment what you need. Everything here is optional —
# the backend runs with zero edits, but Web Push stays disabled until
# REBORN_CONTACT is set.

# VAPID subject for Web Push. Push is OFF until this is set. Must be a real
# mailto: or https: URL you control — Apple's push service 403s on anything
# else instead of just failing quietly per-notification.
# REBORN_CONTACT=mailto:you@example.com

# API access token. Unset means a random one is generated into
# data/token.json and printed at startup.
# REBORN_TOKEN=

# HTTP port for the backend.
# PORT=3131

# Bind address. 0.0.0.0 by default so a tunnel can reach it; set 127.0.0.1
# if you only ever access it from this machine.
# REBORN_HOST=127.0.0.1

# Where state, tokens and keys live.
# REBORN_DATA_DIR=./data

# ============================================================================
# Website settings (Vercel → Project → Settings → Environment Variables).
# Full step-by-step instructions: SETUP_GUIDE.md
# ============================================================================

# --- Password gate (middleware.js) ---
# REBORN_PASS=           your master password (required unless REBORN_GATE=off)
# REBORN_ROTATE_SECRET=  long random string for guest codes + sign-in cookies (required unless REBORN_GATE=off)
# REBORN_USER=reborn     master username (optional)
# REBORN_GATE=off        remove the shared password once customers use accounts

# --- Accounts + cloud sync (Supabase) — VITE_ means "baked into the app" ---
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=        the "anon public" key — safe to publish, RLS protects the data

# --- Payments (Stripe) ---
# VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# VITE_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/...
# Server-only — NEVER add a VITE_ prefix to these, it would publish them:
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      bypasses all security rules — keep secret

# --- Crash reporting (Sentry) ---
# VITE_SENTRY_DSN=https://...@....ingest.sentry.io/...
